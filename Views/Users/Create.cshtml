@model CreateUserViewModel
@{
    ViewData["Title"] = "Add user";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h1 class="h3">Add user</h1>
        <p class="text-muted">The user receives their email address and a temporary password by email. They must choose a new password on first login. Access follows the selected designation's role.</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DesignationId" class="form-label"></label>
                <select asp-for="DesignationId" asp-items="Model.Designations" class="form-select">
                    <option value="">Select designation</option>
                </select>
                <span asp-validation-for="DesignationId" class="text-danger"></span>
            </div>

            <button class="btn btn-primary">Register user &amp; email login</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
