@using DevExtreme.AspNet.Mvc
@using System.Security.Claims
@model PagedResult<UserSummary>
@{
    ViewData["Title"] = "Users";
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var firstRow = (Model.Page - 1) * 50 + 1;
    var rows = Model.Items.Select((user, index) => new
    {
        user.Id,
        Number = firstRow + index,
        LastLogin = user.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "Never"
    }).ToArray();
}

@section GridAssets {
    <partial name="_DevExtremeGridAssets" />
}

<div class="d-flex justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1">Users</h1>
        <p class="text-muted mb-0">Register people, manage their access, and send their first login email.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary text-nowrap">Add user</a>
</div>

<section id="users-workspace" class="school-users-shell">
    <form method="get" class="d-flex gap-2 mb-3" role="search">
        <input name="search" value="@Model.Search" class="form-control"
               placeholder="Search by name or email" aria-label="Search users" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>

    @(Html.DevExtreme().DataGrid()
        .ID("usersGrid")
        .DataSource(rows, "Id")
        .ShowBorders(true)
        .RowAlternationEnabled(true)
        .WordWrapEnabled(true)
        .Sorting(sorting => sorting.Mode(GridSortingMode.None))
        .Paging(paging => paging.Enabled(false))
        .NoDataText("No users found. Try another search or add a user.")
        .Columns(columns =>
        {
            columns.Add().DataField("Number").Caption("Sr. No.").Width(70);
            columns.Add().Name("user").Caption("Name / email").MinWidth(190)
                .CellTemplate(new JS("schoolGrid.cell"));
            columns.Add().Name("designation").Caption("Designation / role").MinWidth(155)
                .CellTemplate(new JS("schoolGrid.cell"));
            columns.Add().Name("status").Caption("Status").MinWidth(165)
                .CellTemplate(new JS("schoolGrid.cell"));
            columns.Add().DataField("LastLogin").Caption("Last login (UTC)").Width(155);
            columns.Add().Name("actions").Caption("Actions").Width(170)
                .CellTemplate(new JS("schoolGrid.cell"));
        }))

    @foreach (var user in Model.Items)
    {
        <template id="usersGrid-user-@user.Id">
            <strong>@user.FullName</strong>
            <div class="text-muted small text-break">@user.Email</div>
        </template>
        <template id="usersGrid-designation-@user.Id">
            <div>@(user.DesignationName ?? "Unassigned")</div>
            <div class="text-muted small">@user.RoleName</div>
        </template>
        <template id="usersGrid-status-@user.Id">
            <span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span>
            <div class="text-muted small mt-1">@(user.MustChangePassword ? "First password change pending" : "Password set")</div>
            <div class="text-muted small">@(user.InvitationSentAt.HasValue ? "Login email sent" : "Email pending")</div>
        </template>
        <template id="usersGrid-actions-@user.Id">
            <div class="d-flex flex-wrap gap-2">
                @if (user.IsActive)
                {
                    <form asp-action="SendPasswordLink" method="post">
                        <input type="hidden" name="id" value="@user.Id" />
                        <button class="btn btn-sm btn-outline-primary">
                            @(user.MustChangePassword ? "Resend login email" : "Send reset link")
                        </button>
                    </form>
                }
                @if (user.Id != currentUserId)
                {
                    <form asp-action="SetActive" method="post">
                        <input type="hidden" name="id" value="@user.Id" />
                        <input type="hidden" name="active" value="@((!user.IsActive).ToString().ToLowerInvariant())" />
                        <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(user.RowVersion)" />
                        <button class="btn btn-sm btn-outline-secondary">@(user.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                }
            </div>
        </template>
    }

    <nav aria-label="User pages" class="d-flex align-items-center gap-2 mt-3">
        @if (Model.Page > 1)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index"
               asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">Previous</a>
        }
        else
        {
            <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Previous</span>
        }
        <span class="text-muted small px-2">Page @Model.Page</span>
        @if (Model.HasNext)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index"
               asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Next</a>
        }
        else
        {
            <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Next</span>
        }
    </nav>
</section>
