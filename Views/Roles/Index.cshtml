@model IReadOnlyList<RoleSummary>
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between mb-3">
    <h1 class="h3">Roles</h1>
    <a asp-action="Create" class="btn btn-primary">Add role</a>
</div>

<p class="text-muted">Administrator manages users, designations, and roles. Other roles currently access the signed-in home page.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Created (UTC)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>@role.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
