@model ChangeTemporaryPasswordViewModel
@{
    ViewData["Title"] = "Choose your password";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <span class="badge text-bg-primary mb-3">First login</span>
                <h1 class="h3">Make this account yours</h1>
                <p class="text-muted">Your temporary password was only for signing in. Set a private password to continue to your school workspace.</p>

                <form asp-action="ChangeTemporaryPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-help" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <div id="password-help" class="form-text">Use 8–100 characters with uppercase, lowercase, a number, and a symbol. Choose a different password from the one in your email.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <partial name="_LoginDeviceFields" for="Device" />
                    <button class="btn btn-primary w-100">Save password &amp; continue</button>
                </form>

                <form asp-action="CancelPasswordSetup" method="post" class="mt-3 text-center">
                    <button class="btn btn-link">Back to login</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login-device.js" asp-append-version="true"></script>
}
