@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Set password";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3">Choose your password</h1>
        <p class="text-muted">Your password is private. Your administrator does not need to know it.</p>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Code" type="hidden" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-help" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <div id="password-help" class="form-text">Use 8–100 characters with uppercase, lowercase, a number, and a symbol.</div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button class="btn btn-primary">Save password</button>
        </form>

        <p class="mt-3">
            <a asp-action="ForgotPassword">Request a new link</a>
        </p>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
