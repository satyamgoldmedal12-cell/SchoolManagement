@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3">Set or reset your password</h1>
        <p class="text-muted">Enter the email registered by your school administrator.</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button class="btn btn-primary">Email password link</button>
        </form>

        <p class="mt-3">
            <a asp-action="Login">Back to login</a>
        </p>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
