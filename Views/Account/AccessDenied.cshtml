@{
    ViewData["Title"] = "Page not accessible";
}

<section class="row justify-content-center py-4 py-md-5" aria-labelledby="access-denied-title">
    <div class="col-sm-10 col-xl-7">
        <div class="border rounded-3 bg-light p-4 p-md-5">
            <i class="fi fi-rr-lock text-secondary fs-3" aria-hidden="true"></i>
            <h1 id="access-denied-title" class="h3 mt-2">Page not accessible</h1>
            <p class="text-muted mb-4">You do not have permission to access this page. Contact your administrator if you need access.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
        </div>
    </div>
</section>
