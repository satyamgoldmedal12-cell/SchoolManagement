@using DevExtreme.AspNet.Mvc

@model IReadOnlyList<PageRegistrationModel>
@{
    ViewData["Title"] = "Module Path";
    ViewData["WideContent"] = true;
    var rows = Model.Select(entry => new
    {
        entry.PathId,
        entry.ParentPageName,
        entry.PageName,
        entry.PageSystemName,
        FullPath = entry.FullPath ?? entry.PageName,
        Route = entry.IsLeafNode ? entry.PathName : "Folder",
        entry.LabelId,
        entry.SequenceId,
        entry.CreatedByName,
        CreatedDate = entry.CreatedDate?.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture),
        IconClass = ModulePathIcons.GetCssClass(entry.PageSystemName),
        EditUrl =  Url.Action("Edit", new { id = entry.PathId }),
        DeleteUrl = Url.Action("Delete", new { id = entry.PathId })
    }).ToArray();
}

@section GridAssets
{
    <partial name="_DevExtremeGridAssets" />
    <script src="~/js/module-path-grid.js" asp-append-version="true"></script>
}

<h1 class="h3 mb-3">Module Path</h1>
<partial name="_Tabs" />

@(Html.DevExtreme().DataGrid()
    .ID("modulePathGrid")
    .DataSource(rows, "PathId")
    .ShowBorders(true)
    .RowAlternationEnabled(true)
    .ColumnAutoWidth(true)
    .NoDataText("No pages found.")
    .SearchPanel(search => search.Visible(true)
        .Placeholder("Search module paths").Text(ViewData["Search"] as string ?? string.Empty))
    .FilterRow(filter => filter.Visible(true))
    .Paging(paging => paging.PageSize(20))
    .Pager(pager => pager.Visible(true).ShowInfo(true).ShowNavigationButtons(true))
    .Columns(columns =>
    {
        columns.Add().Caption("Sr. No.").Width(75)
            .AllowSorting(false).AllowFiltering(false).AllowSearch(false)
            .CellTemplate(new JS("schoolGrid.rowNumber"));
        columns.Add().DataField("ParentPageName").Caption("Parent page");
        columns.Add().DataField("PageName").Caption("Page name").MinWidth(120).CellTemplate(new JS("modulePathGridCells.pageName"));
        columns.Add().DataField("FullPath").Caption("Full page path");
        columns.Add().DataField("Route");
        columns.Add().DataField("LabelId").Caption("Label ID").DataType(GridColumnDataType.Number);
        columns.Add().DataField("SequenceId").Caption("Sequence ID").DataType(GridColumnDataType.Number);
        columns.Add().DataField("CreatedByName").Caption("Created by");
        columns.Add().DataField("CreatedDate").Caption("Created date (UTC)");
        columns.Add().DataField("PageSystemName").Visible(false).AllowSearch(true);
        columns.Add().Caption("Actions").Width(150)
            .AllowSorting(false).AllowFiltering(false).AllowSearch(false)
            .CellTemplate(new JS("modulePathGridCells.actions"));
    }))
