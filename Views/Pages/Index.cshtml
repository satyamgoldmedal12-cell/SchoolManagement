@model IReadOnlyList<PageRegistrationModel>
@{
    ViewData["Title"] = "Module Path";
}

<h1 class="h3 mb-3">Module Path</h1>
<partial name="_Tabs" />

<form asp-action="Index" method="get" class="d-flex gap-2 mb-3" role="search">
    <input type="search" name="search" value="@ViewData["Search"]" class="form-control" aria-label="Search module paths" placeholder="Search by page name or path" />
    <button type="submit" class="btn btn-outline-primary">Search</button>
    @if (ViewData["Search"] is string search && search.Length > 0)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    }
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">No pages registered yet.</p>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Sr. No.</th>
                    <th scope="col">Parent page</th>
                    <th scope="col">Page name</th>
                    <th scope="col">Full page path</th>
                    <th scope="col">Route</th>
                    <th scope="col">Label ID</th>
                    <th scope="col">Sequence ID</th>
                    <th scope="col">Created by</th>
                    <th scope="col">Created date (UTC)</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Model.Count; index++)
                {
                    var entry = Model[index];

                    <tr>
                        <td>@(index + 1)</td>
                        <td>@(entry.ParentPageName ?? "—")</td>
                        <td>
                            @if (ModulePathIcons.GetCssClass(entry.PageSystemName) is string iconClass)
                            {
                                <i class="@iconClass me-1" aria-hidden="true"></i>
                            }
                            @entry.PageName
                        </td>
                        <td class="text-break">@(entry.FullPath ?? entry.PageName)</td>
                        <td class="text-break">@(entry.IsLeafNode ? entry.PathName : "Folder")</td>
                        <td>@entry.LabelId</td>
                        <td>@entry.SequenceId</td>
                        <td>@(entry.CreatedByName ?? "—")</td>
                        <td class="text-nowrap">@(entry.CreatedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@entry.PathId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@entry.PathId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
