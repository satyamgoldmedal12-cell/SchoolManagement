@using DevExtreme.AspNet.Mvc
@model IReadOnlyList<Subjectmodel>
@{
    ViewData["Title"] = "Subjects";
}

@section GridAssets {
    <partial name="_DevExtremeGridAssets" />
}

<div class="d-flex justify-content-between mb-3">
    <h1 class="h3">Subjects</h1>
    @if (ViewData["CanAdd"] is true)
    {
        <a asp-action="Create" class="btn btn-primary">Add subject</a>
    }
</div>

@(Html.DevExtreme().DataGrid()
    .ID("subjectsGrid")
    .DataSource(Model)
    .ShowBorders(true)
    .RowAlternationEnabled(true)
    .NoDataText("No subjects added yet.")
    .SearchPanel(search => search.Visible(true).Placeholder("Search subjects"))
    .Paging(paging => paging.PageSize(20))
    .Pager(pager => pager.Visible(true).ShowInfo(true).ShowNavigationButtons(true))
    .Columns(columns => columns.Add().DataField("SubjectName").Caption("Subject name")))
