@using DevExtreme.AspNet.Mvc

@model IReadOnlyList<Classes>
@{
    ViewData["Title"] = "Classes";
}

@section GridAssets {
    <partial name="_DevExtremeGridAssets" />
}

<div class="d-flex justify-content-between mb-3">
    <h1 class="h3">Classes</h1>
    @if (ViewData["CanAdd"] is true)
    {
        <a asp-action="Create" class="btn btn-primary">Add class</a>
    }
</div>

@(Html.DevExtreme().DataGrid()
    .ID("classesGrid")
    .DataSource(Model)
    .ShowBorders(true)
    .RowAlternationEnabled(true)
    .NoDataText("No classes added yet.")
    .SearchPanel(search => search.Visible(true).Placeholder("Search classes"))
    .Paging(paging => paging.PageSize(20))
    .Pager(pager => pager.Visible(true).ShowInfo(true).ShowNavigationButtons(true))
    .Columns(columns => columns.Add().DataField("ClassName").Caption("Class name")))
