@model IReadOnlyList<DesignationSummary>
@{
    ViewData["Title"] = "Designations";
    var rowNumber = 0;
}

<div class="d-flex justify-content-between mb-3">
    <h1 class="h3">Designations</h1>
    <a asp-action="Create" class="btn btn-primary">Add designation</a>
</div>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sr. No.</th>
                <th>Designation</th>
                <th>Role</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var designation in Model)
            {
                rowNumber++;

                <tr>
                    <td>@rowNumber</td>
                    <td>@designation.DesignationName</td>
                    <td>@designation.RoleName</td>
                    <td>
                        @if (designation.IsActive)
                        {
                            <text>Active</text>
                        }
                        else
                        {
                            <text>Inactive</text>
                        }
                    </td>
                </tr>
            }

            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="4">No designations yet. Add one before creating users.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
