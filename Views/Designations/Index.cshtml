@using DevExtreme.AspNet.Mvc
@model IReadOnlyList<DesignationSummary>
@{
    ViewData["Title"] = "Designations";
    var rows = Model.Select(designation => new
    {
        designation.DesignationId,
        designation.DesignationName,
        designation.RoleName,
        Status = designation.IsActive ? "Active" : "Inactive"
    }).ToArray();
}

@section GridAssets {
    <partial name="_DevExtremeGridAssets" />
}

<div class="d-flex justify-content-between mb-3">
    <h1 class="h3">Designations</h1>
    <a asp-action="Create" class="btn btn-primary">Add designation</a>
</div>

@(Html.DevExtreme().DataGrid()
    .ID("designationsGrid")
    .DataSource(rows, "DesignationId")
    .ShowBorders(true)
    .RowAlternationEnabled(true)
    .NoDataText("No designations yet. Add one before creating users.")
    .SearchPanel(search => search.Visible(true).Placeholder("Search designations"))
    .FilterRow(filter => filter.Visible(true))
    .Paging(paging => paging.PageSize(20))
    .Pager(pager => pager.Visible(true).ShowInfo(true).ShowNavigationButtons(true))
    .Columns(columns =>
    {
        columns.Add().Caption("Sr. No.").Width(75)
            .AllowSorting(false).AllowFiltering(false).AllowSearch(false)
            .CellTemplate(new JS("schoolGrid.rowNumber"));
        columns.Add().DataField("DesignationName").Caption("Designation");
        columns.Add().DataField("RoleName").Caption("Role");
        columns.Add().DataField("Status").Width(110);
    }))
