@{ var signedIn = User.Identity?.IsAuthenticated == true; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolManagement</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/flaticon/css/uicons-regular-rounded.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dist/school.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolManagement.styles.css" asp-append-version="true" />
    @if (IsSectionDefined("GridAssets"))
    {
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        @await RenderSectionAsync("GridAssets")
    }
</head>
<body>
    <header class="border-bottom mb-3">
        <nav class="navbar navbar-light bg-white" aria-label="Account">
            <div class="container-fluid gap-2">
                @if (signedIn)
                {
                    <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse"
                            data-bs-target="#school-sidebar" aria-controls="school-sidebar"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                }
                <a class="navbar-brand me-auto" asp-controller="Home" asp-action="Index">SchoolManagement</a>

                @if (signedIn)
                {
                    <span class="navbar-text d-none d-sm-inline text-break">@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-primary btn-sm">Log out</button>
                    </form>
                }
                else
                {
                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Log in</a>
                }
            </div>
        </nav>
    </header>

    <div class="@(signedIn ? "school-shell" : ViewData["WideContent"] is true ? "container-fluid px-3 px-lg-4" : "container")">
        @if (signedIn)
        {
            <aside id="school-sidebar" class="school-sidebar collapse d-md-block">
                @await Component.InvokeAsync("PageMenu")
            </aside>
        }
        <main role="main" class="school-content pb-3">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success" role="status">@success</div>
            }

            @if (TempData["Warning"] is string warning)
            {
                <div class="alert alert-warning" role="alert">@warning</div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SchoolManagement - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @if (!IsSectionDefined("GridAssets"))
    {
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
    }
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
