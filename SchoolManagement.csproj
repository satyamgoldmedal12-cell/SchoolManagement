<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>SchoolManagement-local-settings</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;tests/**;ClientApp/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Data/Locations/places.tsv.gz" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="wwwroot/lib/bootstrap-icons/bootstrap-icons.min.css" LogicalName="SchoolManagement.BootstrapIcons.css" />
    <EmbeddedResource Include="Data/FontAwesomeIconClasses.json" LogicalName="SchoolManagement.FontAwesomeIcons.json" />
    <EmbeddedResource Include="Data/FlaticonIconClasses.json" LogicalName="SchoolManagement.FlaticonIcons.json" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="DevExtreme.AspNet.Core" Version="26.1.4" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
